<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>대변 상태</title>
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
  <div class="page">
    <div class="container">
      <div class="card">
        <div class="page-header">
          <div>
            <div class="title">대변 상태 기록</div>
            <div class="subtitle">상태와 횟수를 기록해보세요.</div>
          </div>
          <div class="header-actions">
            <button class="icon-btn" type="button" onclick="history.back()" aria-label="뒤로가기">←</button>
            <a class="icon-btn" href="/dashboard" aria-label="홈">⌂</a>
            <span class="badge">Health</span>
          </div>
        </div>

        <form action="/record/bowel" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="status">상태</label>
          <select id="status" name="status" required>
            <option value="">선택</option>
            <option value="normal">정상</option>
            <option value="soft">묽음</option>
            <option value="hard">변비</option>
            <option value="other">기타</option>
          </select>

          <label for="count">횟수</label>
          <input type="number" id="count" name="count" min="0" placeholder="예: 2" required />

          <label for="memo">메모</label>
          <textarea id="memo" name="memo" placeholder="특이사항이 있으면 기록하세요."></textarea>

          <button class="button" type="submit">저장</button>
        </form>
      </div>

      <div class="card chart-card">
        <div class="page-header">
          <div>
            <div class="title">최근 대변 횟수 추이</div>
            <div class="subtitle">최근 기록을 그래프로 확인하세요.</div>
          </div>
          <span class="badge">Trend</span>
        </div>
        <div class="chart-container">
          <canvas id="trendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const chartData = <%- JSON.stringify(chart || { labels: [], values: [] }) %>;
    const labels = chartData.labels.map(d => new Date(d).toLocaleDateString('ko-KR'));
    const ctx = document.getElementById('trendChart').getContext('2d');
    new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: '횟수',
          data: chartData.values,
          backgroundColor: 'rgba(0,184,148,0.35)',
          borderColor: '#00b894'
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } }
      }
    });
  </script>
</body>
</html>
