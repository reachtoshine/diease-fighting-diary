<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>기분 기록</title>
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
  <div class="page">
    <div class="container">
      <div class="card">
        <div class="page-header">
          <div>
            <div class="title">기분 기록</div>
            <div class="subtitle">오늘의 감정을 기록해보세요.</div>
          </div>
          <div class="header-actions">
            <button class="icon-btn" type="button" onclick="history.back()" aria-label="뒤로가기">←</button>
            <a class="icon-btn" href="/dashboard" aria-label="홈">⌂</a>
            <span class="badge">Mood</span>
          </div>
        </div>

        <form action="/record/mood" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="mood">기분</label>
          <select id="mood" name="mood" required>
            <option value="">선택</option>
            <option value="very-good">매우 좋음</option>
            <option value="good">좋음</option>
            <option value="okay">보통</option>
            <option value="bad">나쁨</option>
            <option value="very-bad">매우 나쁨</option>
          </select>

          <label for="energy">에너지 수준</label>
          <select id="energy" name="energy" required>
            <option value="">선택</option>
            <option value="high">높음</option>
            <option value="medium">보통</option>
            <option value="low">낮음</option>
          </select>

          <label for="memo">메모</label>
          <textarea id="memo" name="memo" placeholder="감정 변화나 이유를 기록하세요."></textarea>

          <button class="button" type="submit">저장</button>
        </form>
      </div>

      <div class="card chart-card">
        <div class="page-header">
          <div>
            <div class="title">최근 기분 추이</div>
            <div class="subtitle">기분 점수를 그래프로 확인하세요.</div>
          </div>
          <span class="badge">Trend</span>
        </div>
        <div class="chart-container">
          <canvas id="trendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const chartData = <%- JSON.stringify(chart || { labels: [], values: [] }) %>;
    const labels = chartData.labels.map(d => new Date(d).toLocaleDateString('ko-KR'));
    const ctx = document.getElementById('trendChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: '기분 점수(1~5)',
          data: chartData.values,
          borderColor: '#8b5cf6',
          backgroundColor: 'rgba(139,92,246,0.2)',
          tension: 0.35,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { min: 1, max: 5 } }
      }
    });
  </script>
</body>
</html>
