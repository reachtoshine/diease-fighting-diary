<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>대시보드</title>
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
  <div class="sidebar" id="sidebar">
    <div class="page-header">
      <div class="title">메뉴</div>
    </div>
    <ul>
      <li><a href="/dashboard">🏠 대시보드</a></li>
      <li><a href="/cancer-info">🧬 암 정보 입력</a></li>
      <li><a href="/logout">🚪 로그아웃</a></li>
    </ul>
  </div>

  <div class="page">
    <div class="container">
      <div class="topbar">
        <span class="menu-btn" onclick="toggleSidebar()">☰</span>
        <span><%= new Date().toLocaleDateString() %></span>
      </div>

      <% if (showCancerPopup) { %>
        <div class="popup">
          <strong>🧬 <%= user.nickname %>님</strong> 아직 암 관련 정보를 입력하지 않으셨어요.
          <div class="footer-actions">
            <a class="button" href="/cancer-info">입력하러 가기</a>
          </div>
        </div>
      <% } %>

      <div class="card">
        <div class="page-header">
          <div>
            <div class="title">오늘의 기록</div>
            <div class="subtitle">오늘 몸 상태를 간단히 기록해요.</div>
          </div>
          <span class="badge">케어 로그</span>
        </div>

        <div class="grid grid-3">
          <a class="tile" href="/record/meal">
            <div class="pill">🍱 식사</div>
            <div class="tile-title">식사 기록</div>
            <div class="tile-meta">칼로리와 섭취량</div>
          </a>
          <a class="tile" href="/record/exercise">
            <div class="pill">🏃‍♂️ 운동</div>
            <div class="tile-title">운동량 기록</div>
            <div class="tile-meta">시간과 강도</div>
          </a>
          <a class="tile" href="/record/bowel">
            <div class="pill">🚽 대변</div>
            <div class="tile-title">대변 상태</div>
            <div class="tile-meta">횟수와 상태</div>
          </a>
          <a class="tile" href="/record/temp">
            <div class="pill">🌡 체온</div>
            <div class="tile-title">체온 기록</div>
            <div class="tile-meta">오늘의 체온</div>
          </a>
          <a class="tile" href="/record/pressure">
            <div class="pill">🩸 혈압/혈당</div>
            <div class="tile-title">혈압/혈당</div>
            <div class="tile-meta">측정값 기록</div>
          </a>
          <a class="tile" href="/record/weight">
            <div class="pill">⚖ 체중</div>
            <div class="tile-title">체중 기록</div>
            <div class="tile-meta">몸무게와 변화</div>
          </a>
          <a class="tile" href="/record/mood">
            <div class="pill">😊 기분</div>
            <div class="tile-title">기분 기록</div>
            <div class="tile-meta">오늘의 감정</div>
          </a>
          <a class="tile" href="/record/pain">
            <div class="pill">💥 통증</div>
            <div class="tile-title">통증 기록</div>
            <div class="tile-meta">강도와 위치</div>
          </a>
          <a class="tile" href="/record/water">
            <div class="pill">💧 수분</div>
            <div class="tile-title">물 섭취량</div>
            <div class="tile-meta">하루 섭취량</div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    function toggleSidebar() {
      document.getElementById('sidebar').classList.toggle('active');
    }
  </script>
</body>
</html>
