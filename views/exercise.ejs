<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>운동 기록</title>
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
  <div class="page">
    <div class="container">
      <div class="card">
        <div class="page-header">
          <div>
            <div class="title">운동 기록</div>
            <div class="subtitle">오늘의 운동을 간단히 기록하세요.</div>
          </div>
          <div class="header-actions">
            <button class="icon-btn" type="button" onclick="history.back()" aria-label="뒤로가기">←</button>
            <a class="icon-btn" href="/dashboard" aria-label="홈">⌂</a>
            <span class="badge">Activity</span>
          </div>
        </div>

        <form action="/record/exercise" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="type">운동 종류</label>
          <input type="text" id="type" name="type" placeholder="예: 걷기, 스트레칭" required />

          <div class="split">
            <div>
              <label for="duration">시간(분)</label>
              <input type="number" id="duration" name="duration" min="0" placeholder="30" required />
            </div>
            <div>
              <label for="intensity">강도</label>
              <select id="intensity" name="intensity" required>
                <option value="">선택</option>
                <option value="low">가벼움</option>
                <option value="medium">보통</option>
                <option value="high">강함</option>
              </select>
            </div>
          </div>

          <label for="memo">메모</label>
          <textarea id="memo" name="memo" placeholder="느낌이나 특이사항을 기록하세요."></textarea>

          <button class="button" type="submit">저장</button>
        </form>
      </div>

      <div class="card chart-card">
        <div class="page-header">
          <div>
            <div class="title">최근 운동 추이</div>
            <div class="subtitle">최근 기록을 그래프로 확인하세요.</div>
          </div>
          <span class="badge">Trend</span>
        </div>
        <div class="chart-container">
          <canvas id="trendChart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    const chartData = <%- JSON.stringify(chart || { labels: [], values: [] }) %>;
    const labels = chartData.labels.map(d => new Date(d).toLocaleDateString('ko-KR'));
    const ctx = document.getElementById('trendChart').getContext('2d');
    new Chart(ctx, {
      type: 'line',
      data: {
        labels,
        datasets: [{
          label: '운동 시간(분)',
          data: chartData.values,
          borderColor: '#2e6bff',
          backgroundColor: 'rgba(46,107,255,0.15)',
          tension: 0.35,
          fill: true
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: { y: { beginAtZero: true } }
      }
    });
  </script>
</body>
</html>
