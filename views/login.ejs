<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <title>로그인</title>
  <link rel="stylesheet" href="/style.css">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body>
  <div class="page">
    <div class="container">
      <div class="card login-card">
        <div class="page-header">
          <div>
            <div class="title">로그인</div>
            <div class="subtitle">건강 기록을 시작해볼까요?</div>
          </div>
          <span class="badge">Care Diary</span>
        </div>

        <% if (typeof error !== 'undefined' && error) { %>
          <div class="error-banner">아이디 또는 비밀번호가 일치하지 않습니다.</div>
        <% } %>

        <form action="/login" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="username">이메일 또는 아이디</label>
          <input type="text" id="username" name="username" placeholder="example@email.com" required />

          <label for="password">비밀번호</label>
          <input type="password" id="password" name="password" placeholder="비밀번호를 입력하세요" required />

          <button class="button" type="submit">로그인</button>
        </form>

        <div class="center helper">또는</div>
        <div class="center">
          <a href="/callback/naver">
            <img src="/lg.png" class="naver-login" alt="네이버로 로그인" />
          </a>
        </div>

        <div class="login-links">
          <a href="/register">회원가입</a>
          <span> | </span>
          <a href="/forgot-password">비밀번호 찾기</a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
